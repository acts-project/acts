# Single source of truth for the dependency stack installed by every CI job
# and the wheel build. Read by setup.sh, setup_spack.sh and
# .github/actions/dependencies; DEPENDENCY_TAG is bumped by CI/bump_versions.py.
# Keep to plain KEY=value lines: the action forwards them to $GITHUB_OUTPUT.

# ci-dependencies release providing the lockfiles and buildcache
DEPENDENCY_TAG=v24.4.0
# spack/spack commit
SPACK_VERSION=426ab4d83b93df5c1ace836bd12d514ab2074b77
# spack/spack-packages commit for the builtin repo; tracking develop breaks on
# upstream recipe changes, e.g. deprecating a version our lockfile uses
SPACK_REPO_VERSION=6a3dd42c514510c234f203b5fef392162da80049
