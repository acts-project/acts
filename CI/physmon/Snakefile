# Snakemake workflow for physmon.
#
# Produces the physmon validation artifacts as an explicit DAG so:
#   - Production and comparison both run in parallel (--cores N).
#   - Editing one producer only re-runs that branch.
#   - The catalog of jobs lives in config/physmon.yaml, not in shell ifs.
#
# This file holds mechanism; config/physmon.yaml holds the catalog. One
# producer rule per producer and variant is generated from that file, with its
# outputs, inputs, thread budget and command, so adding a physmon chain or a
# variant means writing or extending a workflow script and editing the catalog
# -- this file and the output paths stay untouched.
#
# Every rule is run through scripts/wrap.sh so it always exits 0 and writes a
# small JSON witness {"step","exit_code","log"}. The summary step joins those witnesses
# against the catalog to produce a multi-column results table and is the single
# place that decides overall pass/fail. This means even when an upstream step
# fails, the rest of the DAG still runs (on touched-empty stand-in files) and
# the summary shows the full failure chain.
#
# Usage (from repo root):
#   snakemake -s CI/physmon/Snakefile --cores N --resources mem_mb=M [target]
#
# M is the memory the jobs may reserve together, in MB; see "Scheduling" below.
# CI/physmon/scripts/memory_budget.sh gives 75% of what the machine may use.
#
# No environment setup is needed first: every rule sources CI/physmon/setup.sh,
# which activates the ACTS build (assumed to be at <repo>/build) for that rule's
# shell only. snakemake itself can therefore be installed against any Python.
#
# Targets:
#   all              everything + summary  (default; fails non-zero if any comparison failed)
#   simulation, kf, gsf, gx2f, refit_kf, refit_gsf, fullchains, gx2f_vs_kf
#                    per-mode meta-targets, one for every `mode` in the
#                    catalog. Each builds only its slice of artifacts and
#                    fails non-zero if any in-scope comparison failed.
#
# Override the output directory:
#   snakemake ... --config outdir=/tmp/physmon

import csv
import json
import os
from pathlib import Path
from types import SimpleNamespace

configfile: "CI/physmon/config/physmon.yaml"

OUTDIR             = config.get("outdir", "physmon")
REFDIR             = "CI/physmon/reference"
REFMANIFEST        = "CI/physmon/reference.sha256"
WORKFLOWS_DIR      = "CI/physmon/workflows"
HISTCMP_CONFIG_DIR = "CI/physmon/config"
WRAP               = "bash CI/physmon/scripts/wrap.sh"

# Every rule's shell activates the ACTS environment itself through setup.sh
# (which expects the build directory at <repo>/build) instead of inheriting it
# from whoever launched snakemake. That is what keeps the ACTS PYTHONPATH out of
# the snakemake process: the ROOT/dd4hep/podio extension modules on it are
# ABI-tied to the ACTS interpreter and segfault any other one that imports them.
#
# This replaces snakemake's default prefix, so keep its `set -euo pipefail`.
shell.prefix(
    'set -euo pipefail; '
    'source CI/physmon/setup.sh; '
)


# ---------------------------------------------------------------------------
# Reference files. They are not committed: reference.sha256 records the SHA256
# of each one, and reference.py pulls the blobs from the registry by content
# hash. Reading the manifest here makes every reference file an ordinary DAG
# output, so a histcmp that needs one waits for the fetch rule instead of
# failing on a missing input.
# ---------------------------------------------------------------------------

def read_reference_manifest(path):
    """Parse reference.sha256 into {relpath: digest}."""
    entries = {}
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        digest, relpath = line.split(maxsplit=1)
        entries[relpath.strip()] = digest
    return entries


REFERENCE_FILES = read_reference_manifest(REFMANIFEST)

# ACTS_PHYSMON_NO_FETCH=1 (or --config fetch_references=0) runs against REFDIR as
# it is on disk. The fetch rule is then not defined at all, so snakemake reports
# any reference it still needs as a missing input file rather than reaching for
# the registry.
FETCH_REFERENCES = bool(
    int(config.get("fetch_references", 0 if os.environ.get("ACTS_PHYSMON_NO_FETCH") else 1))
)

# Scheduling. Every job declares the peak memory it reserves as `mem_mb`. A
# job reaches its peak within seconds (geometry, material and field are loaded
# first) and holds it until it exits, and running it with fewer threads does
# not lower it. So jobs run single-threaded unless the catalog says otherwise,
# the parallelism comes from running them side by side, and
# `--resources mem_mb=<limit>` keeps the sum of the reservations under the
# runner's memory. Each job's measured peak is in {OUTDIR}/benchmarks, and the
# summary lists every job that used more than it reserves.
PLOT_MEM_MB = 300
# histcmp memory follows the size of the two files it compares: below 1 MB it
# needs up to 0.8 GB, the multi-MB fitting performance files up to 1.4 GB.
HISTCMP_MEM_MB = {"small": 1000, "large": 1800}
HISTCMP_LARGE_INPUT_MB = 1


# ---------------------------------------------------------------------------
# Producer catalog, read from the `producers:` block in the config. Each key
# is a slug that names three things by convention: the rule
# (produce_<slug>), the script (workflows/physmon_<slug>.py) and the output
# directory ({OUTDIR}/data/<slug>).
# ---------------------------------------------------------------------------

PRODUCERS = config["producers"]

# All producer slugs the workflow knows about. Used to enumerate witnesses.
# A slug with no matching rule fails at DAG construction ("no rule to produce"
# its witness), so this cannot silently drift from the rules below.
PRODUCER_SLUGS = list(PRODUCERS)

# Producers with a per-variant output subdir layout. Drives witness paths and
# the comparison -> producer mapping for cascade reporting.
PRODUCER_VARIANTS = {
    slug: list(spec["variants"])
    for slug, spec in PRODUCERS.items()
    if spec.get("variants")
}


def variant_spec(slug, variant):
    """A variant entry: a plain display label, or {label, mem_mb} to override
    the producer's mem_mb for this variant."""
    entry = PRODUCERS[slug]["variants"][variant]
    return entry if isinstance(entry, dict) else {"label": entry}


# Producers that consume another producer's output. The upstream slug is the
# leading path component of the input, so the dependency is stated once and
# feeds both the rule's `input:` and the summary's "upstream" step.
PRODUCER_UPSTREAM = {
    slug: spec["inputs"][0].split("/")[0]
    for slug, spec in PRODUCERS.items()
    if spec.get("inputs")
}


# ---------------------------------------------------------------------------
# Trackfinding comparison templates, read from the config. The trackfinding
# workflows all produce the same pack of comparison files
# (seeding/finding/fitting/tracksummary) with optional ambisolver / ML-solver
# / vertexing add-ons, so the pack is described once and expanded per
# producer rather than enumerated per comparison.
# ---------------------------------------------------------------------------

TRACKFINDING_BASE = config["trackfinding_base"]
TRACKFINDING_EXTRAS = config["trackfinding_extras"]


def _expand_row(slug, variant, label, row, vertexing_config):
    """Expand a single template row into a comparison dict (or None to skip)."""
    if variant is not None and variant in row.get("skip_variants", []):
        return None
    prefix = f"{slug}/{variant}/" if variant is not None else f"{slug}/"
    entry = {
        "title":   row["kind_fmt"].format(label=label),
        "current": prefix + row["file"],
        "mode":    "fullchains",
    }
    if "config" in row:
        entry["config"] = row["config"]
    if "plot" in row:
        plot_cfg = row["plot"]["config"]
        if plot_cfg == "{vertexing_config}":
            assert vertexing_config, f"trackfinding row needs vertexing_config: {row}"
            plot_cfg = vertexing_config
        entry["plot"] = {
            "from":   prefix + row["plot"]["from"],
            "tree":   row["plot"]["tree"],
            "config": plot_cfg,
        }
    return entry


def trackfinding_rows(slug):
    """The template rows a trackfinding producer expands: base pack + extras."""
    opts = PRODUCERS[slug]["trackfinding"]
    rows = list(TRACKFINDING_BASE)
    for e in opts.get("extras") or []:
        rows += TRACKFINDING_EXTRAS[e]
    return rows


def expand_trackfinding():
    """Expand every producer carrying a `trackfinding:` block into comparisons.

    Per-producer options under `trackfinding:`:
      - For producers with `variants`: `label_fmt` with a `{variant_label}`
        placeholder. Otherwise: a plain `label`.
      - `extras`: optional list of keys from TRACKFINDING_EXTRAS.
      - `vertexing_config`: required if any vertexing extra is used.
    """
    comparisons = []
    for slug, spec in PRODUCERS.items():
        opts = spec.get("trackfinding")
        if not opts:
            continue
        rows = trackfinding_rows(slug)
        vcfg = opts.get("vertexing_config")
        variants = spec.get("variants")
        if variants:
            assert "label_fmt" in opts, f"{slug} has variants, needs label_fmt"
            for variant in variants:
                var_label = variant_spec(slug, variant)["label"]
                label = opts["label_fmt"].format(variant_label=var_label)
                for row in rows:
                    out = _expand_row(slug, variant, label, row, vcfg)
                    if out is not None:
                        comparisons.append(out)
        else:
            label = opts["label"]
            for row in rows:
                out = _expand_row(slug, None, label, row, vcfg)
                if out is not None:
                    comparisons.append(out)
    return comparisons


# ---------------------------------------------------------------------------
# Catalog: the explicit comparisons from YAML plus trackfinding expansions.
# ---------------------------------------------------------------------------

COMPARISONS = list(config["comparisons"]) + expand_trackfinding()


# ---------------------------------------------------------------------------
# Catalog indexes
# ---------------------------------------------------------------------------

PLOTS = {c["current"]: c["plot"] for c in COMPARISONS if "plot" in c}
COMP_BY_CURRENT = {c["current"]: c for c in COMPARISONS}


# ---------------------------------------------------------------------------
# Path helpers
# ---------------------------------------------------------------------------

def _rel_no_root(rel):
    """Strip a trailing '.root' from a path-like string."""
    assert rel.endswith(".root"), rel
    return rel[:-len(".root")]


def html_for(comp):
    """{OUTDIR}/html/<current-with-.root-replaced-by-.html>."""
    return f"{OUTDIR}/html/" + _rel_no_root(comp["current"]) + ".html"


def witness_for_producer(slug, variant=None):
    if variant:
        return f"{OUTDIR}/witnesses/producer/{slug}/{variant}.json"
    return f"{OUTDIR}/witnesses/producer/{slug}.json"


def witness_for_plot(rel_no_root):
    return f"{OUTDIR}/witnesses/plot/{rel_no_root}.json"


def witness_for_histcmp(rel_no_root):
    return f"{OUTDIR}/witnesses/histcmp/{rel_no_root}.json"


def producer_info_for_comp(comp):
    """Return (slug, variant) — which producer owns this comparison's `current` file.

    Variant is None unless the producer has variants.
    """
    parts = comp["current"].split("/")
    slug = parts[0]
    variants = PRODUCER_VARIANTS.get(slug)
    if variants and len(parts) >= 2 and parts[1] in variants:
        return slug, parts[1]
    return slug, None


def upstream_slug_for(slug):
    """Return the upstream producer slug if this producer has one, else None."""
    return PRODUCER_UPSTREAM.get(slug)


def comps_for_mode(mode):
    return [c for c in COMPARISONS if c["mode"] == mode]


# Every `mode` the catalog uses, in order of first appearance.
MODES = list(dict.fromkeys(c["mode"] for c in COMPARISONS))


# ---------------------------------------------------------------------------
# Producer rule directives, derived from the catalog.
#
# Every producer rule's outputs are implied by the comparisons it feeds, so
# they are computed here instead of being written out by hand. Two rules:
#
#   - A comparison with a `plot` block consumes the raw ntuple named by
#     `plot.from`; that ntuple is the producer's output and is temp(), since
#     plot_hist turns it into the `_hist.root` that is actually compared.
#     Without a `plot` block, the compared file *is* the producer's output.
#   - A comparison whose reference is produced rather than fetched
#     (reference_in: outdir) also has that reference produced here.
#
# Files a script writes that no comparison consumes have to be declared as
# `extra_outputs` in the config, or snakemake would not know about them.
# ---------------------------------------------------------------------------

def comps_for_producer(slug, variant=None):
    """Comparisons whose `current` file this producer (and variant) produces."""
    return [c for c in COMPARISONS if producer_info_for_comp(c) == (slug, variant)]


def _output_key(rel):
    """A stable, unique keyword-argument name for an output path."""
    return Path(rel).name[: -len(".root")] if rel.endswith(".root") else Path(rel).name


def producer_outputs(slug, variant=None):
    """The `output:` mapping for the rule of one producer (and variant)."""
    prefix = f"{slug}/{variant}/" if variant is not None else f"{slug}/"

    outputs = {}
    for comp in comps_for_producer(slug, variant):
        if "plot" in comp:
            rel = comp["plot"]["from"]
            outputs[_output_key(rel)] = temp(f"{OUTDIR}/data/{rel}")
        else:
            rel = comp["current"]
            outputs[_output_key(rel)] = f"{OUTDIR}/data/{rel}"
        if comp.get("reference_in") == "outdir":
            rel = comp["reference"]
            outputs[_output_key(rel)] = f"{OUTDIR}/data/{rel}"

    for rel in PRODUCERS[slug].get("extra_outputs") or []:
        outputs[_output_key(rel)] = f"{OUTDIR}/data/{prefix}{rel}"

    assert "witness" not in outputs, f"{slug}: an output is named 'witness'"
    outputs["witness"] = witness_for_producer(slug, variant)
    return outputs


def producer_inputs(slug):
    return [f"{OUTDIR}/data/{rel}" for rel in PRODUCERS[slug].get("inputs") or []]


def producer_threads(slug):
    return PRODUCERS[slug].get("threads", 1)


def producer_mem_mb(slug, variant=None):
    if variant is not None and "mem_mb" in variant_spec(slug, variant):
        return variant_spec(slug, variant)["mem_mb"]
    assert "mem_mb" in PRODUCERS[slug], f"producer {slug} needs a mem_mb"
    return PRODUCERS[slug]["mem_mb"]


def producer_priority(slug):
    """Start producers that other producers wait for first."""
    return 1 if slug in PRODUCER_UPSTREAM.values() else 0


def benchmark_for(kind, rel):
    return f"{OUTDIR}/benchmarks/{kind}/{rel}.tsv"


def producer_log(slug, variant=None):
    stem = f"{slug}_{variant}" if variant is not None else slug
    return f"{OUTDIR}/logs/{stem}.log"


def producer_command(slug, variant, threads):
    """The script invocation. Scripts and output dirs follow the slug."""
    outdir = f"{OUTDIR}/data/{slug}"
    cmd = f"python3 {WORKFLOWS_DIR}/physmon_{slug}.py "
    if variant is not None:
        cmd += f"{outdir}/{variant} --variant {variant} "
    else:
        cmd += f"{outdir} "
    cmd += f"--threads {threads}"
    return cmd


def producer_command_param(slug, variant):
    """producer_command() as a params function, bound to this slug and variant.

    The producer rules are defined in a loop, and a shell: directive is only
    evaluated when the job runs, after the loop has moved on. Binding the
    command through params keeps each rule on its own slug and variant.
    """
    return lambda wildcards, threads: producer_command(slug, variant, threads)


def _check_histcmp_witnesses(comps):
    """Read histcmp witnesses for `comps`; exit non-zero if any failed.

    Used by per-mode meta-targets so e.g. `snakemake kf` fails when the KF
    comparison failed. The richer multi-column summary still requires `all`.
    """
    import sys
    exit_code = 0
    failed = []
    for c in comps:
        wpath = witness_for_histcmp(_rel_no_root(c["current"]))
        try:
            w = json.loads(Path(wpath).read_text())
        except (OSError, ValueError) as e:
            print(f"physmon: cannot read witness {wpath}: {e}", file=sys.stderr)
            exit_code |= 1
            continue
        if w["exit_code"] != 0:
            exit_code |= w["exit_code"]
            failed.append((c["title"], w))
    for title, w in failed:
        log = w.get("log") or "(no log)"
        print(f"physmon: comparison failed: {title} (exit code {w['exit_code']}, log={log})", file=sys.stderr)
    if exit_code != 0:
        raise SystemExit(exit_code)


def _all_witnesses():
    """Every witness path the workflow should produce. Used by build_results' input."""
    paths = []
    for slug in PRODUCER_SLUGS:
        variants = PRODUCER_VARIANTS.get(slug)
        if variants:
            for v in variants:
                paths.append(witness_for_producer(slug, v))
        else:
            paths.append(witness_for_producer(slug))
    for c in COMPARISONS:
        if "plot" in c:
            paths.append(witness_for_plot(_rel_no_root(c["current"])))
        paths.append(witness_for_histcmp(_rel_no_root(c["current"])))
    return paths


# ---------------------------------------------------------------------------
# Default target — `all`. Triggers full DAG + summary.
# ---------------------------------------------------------------------------

rule all:
    input:
        f"{OUTDIR}/summary.md",
        f"{OUTDIR}/summary.html",
    default_target: True


# ---------------------------------------------------------------------------
# Per-mode meta-targets. Pull only their slice of comparisons; check their
# histcmp witnesses via a small run: gate so partial runs fail correctly.
# ---------------------------------------------------------------------------

# The mode reaches the run block through params: the block only runs with the
# job, after the loop has moved on.
for _mode in MODES:
    rule:
        name: _mode
        input:
            [html_for(c) for c in comps_for_mode(_mode)],
            [witness_for_histcmp(_rel_no_root(c["current"])) for c in comps_for_mode(_mode)],
        params: mode = _mode
        run: _check_histcmp_witnesses(comps_for_mode(params.mode))


# ---------------------------------------------------------------------------
# Producer rules: one per producer, and per variant for producers that have
# variants, named produce_<slug> or produce_<slug>_<variant>, so
# `snakemake produce_<slug>_<variant>` runs a single one. Every directive comes
# from the catalog, so a new `producers:` block or variant needs no change here.
#
# Outputs that feed plot_hist come back from producer_outputs() wrapped in
# temp(), so snakemake auto-cleans the large ntuples once they have been
# consumed.
# ---------------------------------------------------------------------------

def producer_rule_name(slug, variant=None):
    return f"produce_{slug}" + (f"_{variant}" if variant is not None else "")


for _slug in PRODUCER_SLUGS:
    for _variant in PRODUCER_VARIANTS.get(_slug, [None]):
        rule:
            name:    producer_rule_name(_slug, _variant)
            input:   producer_inputs(_slug)
            output:  **producer_outputs(_slug, _variant)
            log:     producer_log(_slug, _variant)
            threads: producer_threads(_slug)
            resources: mem_mb = producer_mem_mb(_slug, _variant)
            priority: producer_priority(_slug)
            benchmark: benchmark_for("producer", producer_rule_name(_slug, _variant))
            params:  cmd = producer_command_param(_slug, _variant)
            shell:
                WRAP + " --witness {output.witness} --step producer --log {log} "
                "--touches '{output}' -- {params.cmd}"


# ---------------------------------------------------------------------------
# Plot rule: ntuple ROOT -> histogrammed ROOT via Examples/Scripts/generic_plotter.py.
# ---------------------------------------------------------------------------

def _plot_input(wildcards):
    return f"{OUTDIR}/data/" + PLOTS[wildcards.rel + "_hist.root"]["from"]

def _plot_tree(wildcards):
    return PLOTS[wildcards.rel + "_hist.root"]["tree"]

def _plot_config(wildcards):
    return f"{HISTCMP_CONFIG_DIR}/" + PLOTS[wildcards.rel + "_hist.root"]["config"]


rule plot_hist:
    input:
        ntuple = _plot_input,
    output:
        hist    = f"{OUTDIR}/data/{{rel}}_hist.root",
        witness = f"{OUTDIR}/witnesses/plot/{{rel}}_hist.json",
    params:
        tree   = _plot_tree,
        config = _plot_config,
    log:
        f"{OUTDIR}/logs/plot_{{rel}}_hist.log",
    resources:
        mem_mb = PLOT_MEM_MB,
    benchmark:
        benchmark_for("plot", "{rel}_hist")
    shell:
        WRAP + " --witness {output.witness} --step plot --log {log} "
        "--touches '{output}' -- "
        "python3 Examples/Scripts/generic_plotter.py "
        "{input.ntuple} {params.tree} {output.hist} "
        "--silent --config {params.config}"


# ---------------------------------------------------------------------------
# Reference fetch. One rule for the whole manifest: reference.py pull is
# all-or-nothing, and it downloads in parallel and caches by digest, so pulling
# per file would be slower rather than more granular.
#
# Deliberately not run through wrap.sh. Every other rule is wrapped so a failure
# degrades into a red cell in the summary, but with no references there is
# nothing to compare against at all, so this one must fail the workflow instead
# of letting each histcmp run against an empty stand-in.
# ---------------------------------------------------------------------------

if FETCH_REFERENCES:

    rule fetch_references:
        input:
            manifest = REFMANIFEST,
        output:
            [f"{REFDIR}/{rel}" for rel in REFERENCE_FILES],
        params:
            refdir = REFDIR,
        log:
            f"{OUTDIR}/logs/fetch_references.log",
        resources:
            mem_mb = 500,
        shell:
            "mkdir -p $(dirname {log}) && "
            "uv run --no-project CI/physmon/reference.py pull "
            "--manifest {input.manifest} --reference-dir {params.refdir} 2>&1 | tee {log}"


# ---------------------------------------------------------------------------
# histcmp rule.
# ---------------------------------------------------------------------------

def _histcmp_current(wildcards):
    return f"{OUTDIR}/data/" + wildcards.rel + ".root"

def _histcmp_reference(wildcards):
    rel = wildcards.rel + ".root"
    comp = COMP_BY_CURRENT[rel]
    ref_rel = comp.get("reference", rel)
    if comp.get("reference_in") == "outdir":
        return f"{OUTDIR}/data/{ref_rel}"
    return f"{REFDIR}/{ref_rel}"

def _histcmp_reference_input(wildcards):
    """The reference as an input, unless the manifest has no entry for it.

    A new comparison has no reference until a run's outputs are published.
    Without it as an input, histcmp fails on the missing file and the
    comparison is reported as failed, so the run still produces the outputs
    and the candidate manifest that publishing needs.
    """
    path = _histcmp_reference(wildcards)
    if path.startswith(f"{REFDIR}/") and path[len(REFDIR) + 1:] not in REFERENCE_FILES:
        return []
    return path

def histcmp_mem_mb(input_mb):
    large = input_mb >= HISTCMP_LARGE_INPUT_MB
    return HISTCMP_MEM_MB["large" if large else "small"]

def _histcmp_mem_mb(wildcards, input):
    return histcmp_mem_mb(input.size_mb)

def _histcmp_params(wildcards):
    rel = wildcards.rel + ".root"
    comp = COMP_BY_CURRENT[rel]
    # standard.toml carries histcmp's default checks for comparisons without
    # a config of their own.
    cfg = comp.get("config", "standard.toml")
    return {
        "title":       comp["title"],
        "config_flag": f"--config {HISTCMP_CONFIG_DIR}/{cfg}",
        "label_ref":   comp.get("label_reference", "reference"),
        "label_mon":   comp.get("label_monitored", "monitored"),
    }


rule histcmp:
    input:
        current   = _histcmp_current,
        reference = _histcmp_reference_input,
    output:
        html    = f"{OUTDIR}/html/{{rel}}.html",
        witness = f"{OUTDIR}/witnesses/histcmp/{{rel}}.json",
    params:
        p = _histcmp_params,
        reference = _histcmp_reference,
    log:
        f"{OUTDIR}/logs/histcmp_{{rel}}.log",
    resources:
        mem_mb = _histcmp_mem_mb,
    benchmark:
        benchmark_for("histcmp", "{rel}")
    shell:
        WRAP + " --witness {output.witness} --step histcmp --log {log} "
        "--touches '{output}' -- "
        "histcmp {input.current} {params.reference} "
        "--jobs {threads} "
        "--label-reference={params.p[label_ref]} "
        "--label-monitored={params.p[label_mon]} "
        "--title={params.p[title]:q} "
        # scatter renders 3D histograms much faster than the default voxel
        # renderer at every histogram size
        "--renderer-3d scatter "
        "-o {output.html} "
        "-p {output.html}_plots "
        "{params.p[config_flag]}"


# ---------------------------------------------------------------------------
# build_results: join all witnesses against the catalog into a single rich
# results JSON. The summary rule renders this to md/html.
# ---------------------------------------------------------------------------

def _read_witness(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {"step": "?", "exit_code": -1, "log": None}


def _comparison_row(comp):
    slug, variant = producer_info_for_comp(comp)
    steps = []
    upstream = upstream_slug_for(slug)
    if upstream:
        w = _read_witness(witness_for_producer(upstream))
        steps.append({"kind": "upstream", "name": upstream, "exit_code": w["exit_code"], "log": w.get("log")})
    prw = _read_witness(witness_for_producer(slug, variant))
    prod_label = slug + (f"/{variant}" if variant else "")
    steps.append({"kind": "producer", "name": prod_label, "exit_code": prw["exit_code"], "log": prw.get("log")})
    if "plot" in comp:
        pw = _read_witness(witness_for_plot(_rel_no_root(comp["current"])))
        steps.append({"kind": "plot", "name": "plot", "exit_code": pw["exit_code"], "log": pw.get("log")})
    hw = _read_witness(witness_for_histcmp(_rel_no_root(comp["current"])))
    steps.append({"kind": "histcmp", "name": "histcmp", "exit_code": hw["exit_code"], "log": hw.get("log")})
    # Mark cascade: any step after the first failure inherits the failure.
    first_failed = False
    for s in steps:
        if first_failed and s["exit_code"] != 0:
            s["cascade"] = True
        else:
            s["cascade"] = False
        if s["exit_code"] != 0:
            first_failed = True
    # Which reference file this comparison covers, and which output would
    # replace it. reference.py candidate turns a failing comparison into a
    # manifest entry from these two. A comparison between two monitored outputs
    # (reference_in: outdir) has no reference and leaves both empty, which
    # candidate skips.
    if comp.get("reference_in") == "outdir":
        ref_path, monitored_path = "", ""
    else:
        ref_path = comp.get("reference", comp["current"])
        monitored_path = comp["current"]
    return {
        "title":          comp["title"],
        "mode":           comp["mode"],
        "report":         "html/" + _rel_no_root(comp["current"]) + ".html",
        "info_only":      comp.get("info_only", False),
        "steps":          steps,
        "ref_path":       ref_path,
        "monitored_path": monitored_path,
    }


def _memory_rows():
    """Every job's reservation next to the peak its benchmark measured."""
    jobs = []
    for slug in PRODUCER_SLUGS:
        for variant in PRODUCER_VARIANTS.get(slug, [None]):
            name = producer_rule_name(slug, variant)
            jobs.append((name, producer_mem_mb(slug, variant), benchmark_for("producer", name)))
    for c in COMPARISONS:
        rel = _rel_no_root(c["current"])
        if "plot" in c:
            jobs.append((f"plot {rel}", PLOT_MEM_MB, benchmark_for("plot", rel)))
        wc = SimpleNamespace(rel=rel)
        files = [_histcmp_current(wc), _histcmp_reference(wc)]
        input_mb = sum(os.path.getsize(f) for f in files if os.path.exists(f)) / 2**20
        jobs.append((f"histcmp {rel}", histcmp_mem_mb(input_mb), benchmark_for("histcmp", rel)))

    rows = []
    for name, reserved, bench in jobs:
        try:
            with open(bench, newline="") as f:
                measured = next(csv.DictReader(f, delimiter="\t"))
        except (OSError, StopIteration):
            continue
        rows.append({
            "job":         name,
            "reserved_mb": reserved,
            "max_pss_mb":  round(float(measured["max_pss"])),
            "max_rss_mb":  round(float(measured["max_rss"])),
            "wall_s":      round(float(measured["s"]), 1),
        })
    return rows


def _histcmp_rc(row):
    """The row's histcmp exit code — what candidate keys 'needs replacing' off."""
    for s in row["steps"]:
        if s["kind"] == "histcmp":
            return s["exit_code"]
    return -1


rule build_results:
    input:
        _all_witnesses(),
    output:
        results = f"{OUTDIR}/physmon_results.json",
        # One row per comparison (title, report, histcmp exit code, reference path,
        # monitored path): reference.py candidate reads it to write
        # reference-candidate.sha256 for the reference publish workflow.
        csv     = f"{OUTDIR}/histcmp_results.csv",
        memory  = f"{OUTDIR}/memory.json",
    run:
        Path(output.memory).write_text(json.dumps(_memory_rows(), indent=2) + "\n")
        rows = [_comparison_row(c) for c in COMPARISONS]
        Path(output.results).write_text(json.dumps(rows, indent=2) + "\n")
        with open(output.csv, "w", newline="") as f:
            writer = csv.writer(f)
            for row in rows:
                writer.writerow([
                    row["title"],
                    row["report"],
                    _histcmp_rc(row),
                    row["ref_path"],
                    row["monitored_path"],
                ])


# ---------------------------------------------------------------------------
# Reference candidate: the manifest that would apply if every failing
# comparison in this run were accepted, plus the manifest the run actually used.
# Both ship in the physmon artifact, which is the whole interface to the
# reference publish workflow: `reference.py update <run>` reads
# reference-candidate.sha256 and takes the new blobs from data/<ref_path>.
# ---------------------------------------------------------------------------

rule reference_candidate:
    input:
        results  = f"{OUTDIR}/histcmp_results.csv",
        manifest = REFMANIFEST,
    output:
        candidate = f"{OUTDIR}/reference-candidate.sha256",
        manifest  = f"{OUTDIR}/reference.sha256",
    params:
        data_dir = f"{OUTDIR}/data",
    shell:
        "cp {input.manifest} {output.manifest} && "
        "uv run --no-project CI/physmon/reference.py candidate "
        "--manifest {input.manifest} --results {input.results} "
        "--data-dir {params.data_dir} --output {output.candidate}"


# ---------------------------------------------------------------------------
# Summary: JSON -> markdown + html. Exits non-zero if any non-info row failed,
# which is what fails snakemake and surfaces failure to CI.
#
# Depends on the candidate manifest so it is written first. The candidate
# matters precisely when comparisons fail, and this rule failing is what stops
# the workflow — an independent rule could be left unscheduled.
# ---------------------------------------------------------------------------

rule summary:
    input:
        results   = f"{OUTDIR}/physmon_results.json",
        memory    = f"{OUTDIR}/memory.json",
        candidate = f"{OUTDIR}/reference-candidate.sha256",
    output:
        md      = f"{OUTDIR}/summary.md",
        html    = f"{OUTDIR}/summary.html",
    shell:
        "python3 CI/physmon/summary.py {input.results} --memory {input.memory} "
        "--md {output.md} --html {output.html}"
