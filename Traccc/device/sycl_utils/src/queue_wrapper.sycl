// Project include(s).
#include "traccc/sycl/utils/queue_wrapper.hpp"

// SYCL include(s).
#include <sycl/sycl.hpp>
namespace traccc::sycl {

queue_wrapper::queue_wrapper(void* queue) : m_queue(queue) {}

void* queue_wrapper::queue() {
  return m_queue;
}

const void* queue_wrapper::queue() const {
  return m_queue;
}

void queue_wrapper::enqueue_callback(std::function<void()> func) const {
  assert(m_queue != nullptr);

  auto& sycl_queue = *(reinterpret_cast<::sycl::queue*>(m_queue));
  sycl_queue.submit([func = std::move(func)](::sycl::handler& cgh) {
    cgh.host_task([func = std::move(func)]() { func(); });
  });
}
}  // namespace traccc::sycl
