// ===========================================================================
// gbts_seeding_algorithm: kernel launchers
// ===========================================================================

gbts_seeding_algorithm::gbts_seeding_algorithm(
    const gbts_seedfinder_config& cfg, const memory_resource& mr,
    const vecmem::copy& copy, queue_wrapper& queue,
    std::unique_ptr<const Logger> logger)
    : device::gbts_seeding_algorithm(cfg, mr, copy, std::move(logger)),
      sycl::algorithm_base{queue} {}

void gbts_seeding_algorithm::gbts_bin_spacepoints_kernel(
    const device::gbts_bin_spacepoints_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 128;
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_bin_spacepoints>(
        details::calculate1DimNdRange(payload.nSp, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_bin_spacepoints(details::thread_id<1>{item}, payload);
        });
  });

  // Turn the per-bin node counts into the node offsets.
  vecmem::device_vector<unsigned int> d_eta_node_counter(
      payload.eta_node_counter);
  oneapi::dpl::exclusive_scan(
      oneapi::dpl::execution::device_policy{squeue}, d_eta_node_counter.begin(),
      d_eta_node_counter.end(), d_eta_node_counter.begin(), 0u);
}

void gbts_seeding_algorithm::gbts_sort_nodes_kernel(
    const device::gbts_sort_nodes_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  // Order the nodes by their (eta bin, phi, spacepoint index bits) keys,
  // carrying the full spacepoint index along as the value.
  oneapi::dpl::sort_by_key(
      oneapi::dpl::execution::device_policy{squeue}, payload.sort_keys.ptr(),
      payload.sort_keys.ptr() + payload.nNodes, payload.sort_values.ptr());

  const unsigned int n_threads = 256;
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_sort_nodes>(
        details::calculate1DimNdRange(payload.nNodes, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_sort_nodes(details::thread_id<1>{item}, payload);
        });
  });
}

void gbts_seeding_algorithm::gbts_find_minmax_radius_kernel(
    const device::gbts_find_minmax_radius_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 128;
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_find_minmax_radius>(
        details::calculate1DimNdRange(payload.nEtaBins, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_find_minmax_radius(details::thread_id<1>{item}, payload);
        });
  });
}

void gbts_seeding_algorithm::gbts_build_edge_work_list_kernel(
    const device::gbts_build_edge_work_list_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  squeue.submit([&](::sycl::handler& h) {
    vecmem::sycl::local_accessor<unsigned int> scratch(
        device::gbts_build_edge_work_list_block_size, h);
    h.parallel_for<kernels::gbts_build_edge_work_list>(
        details::calculate1DimNdRange(
            device::gbts_build_edge_work_list_block_size,
            device::gbts_build_edge_work_list_block_size),
        [payload, scratch](::sycl::nd_item<1> item) {
          const details::barrier<1> barrier{item};
          device::gbts_build_edge_work_list(
              details::thread_id<1>{item}, barrier, payload,
              {vecmem::data::vector_view<unsigned int>(
                  device::gbts_build_edge_work_list_block_size, &scratch[0])});
        });
  });
}

void gbts_seeding_algorithm::gbts_count_graph_edges_kernel(
    const device::gbts_count_graph_edges_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  // One thread per inner node of a chunk. The blocks stride over the work
  // items.
  const unsigned int n_threads = device::gbts_consts::edge_chunk_size;
  const unsigned int n_blocks =
      std::min(payload.nWorkMax, device::gbts_count_graph_edges_max_blocks);
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_count_graph_edges>(
        details::calculate1DimNdRange(n_blocks * n_threads, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_count_graph_edges(details::thread_id<1>{item}, payload);
        });
  });

  // Turn the per-node counts into the edge buckets.
  vecmem::device_vector<unsigned int> d_num_outgoing_edges(
      payload.num_outgoing_edges);
  oneapi::dpl::inclusive_scan(oneapi::dpl::execution::device_policy{squeue},
                              d_num_outgoing_edges.begin(),
                              d_num_outgoing_edges.end(),
                              d_num_outgoing_edges.begin());
}

void gbts_seeding_algorithm::gbts_fill_graph_edges_kernel(
    const device::gbts_fill_graph_edges_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = device::gbts_consts::edge_chunk_size;
  const unsigned int n_blocks =
      std::min(payload.nWorkMax, device::gbts_fill_graph_edges_max_blocks);
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_fill_graph_edges>(
        details::calculate1DimNdRange(n_blocks * n_threads, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_fill_graph_edges(details::thread_id<1>{item}, payload);
        });
  });
}

void gbts_seeding_algorithm::gbts_match_graph_edges_kernel(
    const device::gbts_match_graph_edges_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 256;
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_match_graph_edges>(
        details::calculate1DimNdRange(payload.nEdgesMax, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_match_graph_edges(details::thread_id<1>{item}, payload);
        });
  });

  // Compact the kept edges with a prefix sum over their 0/1 flags.
  oneapi::dpl::inclusive_scan(
      oneapi::dpl::execution::device_policy{squeue}, payload.kept.ptr(),
      payload.kept.ptr() + payload.nEdgesMax, payload.reIndexer.ptr());
}

