void gbts_seeding_algorithm::gbts_count_paths_kernel(
    const device::gbts_count_paths_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 128;
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_count_paths>(
        details::calculate1DimNdRange(payload.nConnectedEdges, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_count_paths(details::thread_id<1>{item}, payload);
        });
  });

  // Path offsets of the path store.
  oneapi::dpl::inclusive_scan(
      oneapi::dpl::execution::device_policy{squeue}, payload.path_counts.ptr(),
      payload.path_counts.ptr() + payload.nConnectedEdges,
      payload.path_counts.ptr());
}

