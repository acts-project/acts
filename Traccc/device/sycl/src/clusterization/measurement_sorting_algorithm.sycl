// SYCL include(s).
#include <sycl/sycl.hpp>

// Local include(s).
#include "../utils/calculate1DimNdRange.hpp"
#include "../utils/get_queue.hpp"
#include "../utils/oneDPL.hpp"
#include "traccc/sycl/clusterization/measurement_sorting_algorithm.hpp"

// Project include(s).
#include "traccc/clusterization/device/measurement_sorting.hpp"

// VecMem include(s).
#include <vecmem/containers/data/vector_buffer.hpp>

namespace traccc::sycl {
namespace kernels {

/// Kernel filling the sorting keys and the measurement indices.
class fill_measurement_sort_keys;

/// Kernel filling the output buffer with sorted measurements.
class fill_sorted_measurements;

}  // namespace kernels

measurement_sorting_algorithm::measurement_sorting_algorithm(
    const traccc::memory_resource& mr, const vecmem::copy& copy,
    queue_wrapper& queue, std::unique_ptr<const Logger> logger)
    : device::measurement_sorting_algorithm(mr, copy, std::move(logger)),
      sycl::algorithm_base(queue) {}

void measurement_sorting_algorithm::sorting_kernel(
    const measurement_sorting_kernel_payload& payload) const {
  const unsigned int n_measurements = payload.n_measurements;
  ::sycl::queue& squeue = details::get_queue(this->queue());
  auto policy = oneapi::dpl::execution::device_policy{squeue};

  // Sorting keys and index sequence.
  vecmem::data::vector_buffer<device::measurement_sort_key_t> keys(
      n_measurements, mr().main);
  vecmem::data::vector_buffer<unsigned int> indices(n_measurements, mr().main);
  copy().setup(keys)->wait();
  copy().setup(indices)->wait();

  const unsigned int num_threads = warp_size() * 8;

  // Sort the indices by the sorting keys, with a radix sort.
  squeue
      .submit([&](::sycl::handler& h) {
        h.parallel_for<kernels::fill_measurement_sort_keys>(
            details::calculate1DimNdRange(n_measurements, num_threads),
            [measurements_view = payload.measurements,
             keys_view = vecmem::get_data(keys),
             indices_view =
                 vecmem::get_data(indices)](::sycl::nd_item<1> item) {
              device::fill_measurement_sort_keys(
                  static_cast<unsigned int>(item.get_global_id(0)),
                  measurements_view, keys_view, indices_view);
            });
      })
      .wait_and_throw();
  oneapi::dpl::sort_by_key(policy, keys.ptr(), keys.ptr() + n_measurements,
                           indices.ptr());

  // Fill the output with the sorted measurements.
  squeue
      .submit([&](::sycl::handler& h) {
        h.parallel_for<kernels::fill_sorted_measurements>(
            details::calculate1DimNdRange(n_measurements, num_threads),
            [measurements_view = payload.measurements,
             output_view = vecmem::get_data(payload.output),
             sorted_indices_view =
                 vecmem::get_data(indices)](::sycl::nd_item<1> item) {
              device::fill_sorted_measurements(
                  static_cast<unsigned int>(item.get_global_id(0)),
                  measurements_view, output_view, sorted_indices_view);
            });
      })
      .wait_and_throw();
}

}  // namespace traccc::sycl
