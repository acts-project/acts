// SYCL include(s).
#include <sycl/sycl.hpp>

// Project include(s).
#include "traccc/device/mutex.hpp"

// VecMem include(s).
#include <vecmem/memory/sycl/device_memory_resource.hpp>
#include <vecmem/memory/sycl/shared_memory_resource.hpp>
#include <vecmem/memory/unique_ptr.hpp>

// GoogleTest include(s).
#include <gtest/gtest.h>

TEST(SYCLMutex, MassAdditionKernel) {
  ::sycl::queue queue;
  vecmem::sycl::device_memory_resource device_mr{&queue};
  vecmem::sycl::shared_memory_resource shared_mr{&queue};

  vecmem::unique_alloc_ptr<std::uint32_t> out =
      vecmem::make_unique_alloc<std::uint32_t>(shared_mr);
  vecmem::unique_alloc_ptr<std::uint32_t> lock =
      vecmem::make_unique_alloc<std::uint32_t>(device_mr);

  queue.memset(lock.get(), 0, sizeof(std::uint32_t)).wait_and_throw();
  queue.memset(out.get(), 0, sizeof(std::uint32_t)).wait_and_throw();

  std::uint32_t n_blocks = 262144;
  std::uint32_t n_threads = 32;

  ::sycl::nd_range test_range(::sycl::range<1>(n_blocks * n_threads),
                              ::sycl::range<1>(n_threads));

  queue
      .submit([&, out = out.get(), lock = lock.get()](::sycl::handler &h) {
        h.parallel_for<class MassAdditionTest>(
            test_range, [=](::sycl::nd_item<1> item) {
              traccc::device::mutex m(*lock);

              if (item.get_local_id()[0] == 0) {
                m.lock();
                std::uint32_t tmp = *out;
                tmp += 1;
                *out = tmp;
                m.unlock();
              }
            });
      })
      .wait_and_throw();

  EXPECT_EQ(n_blocks, *out.get());
}
