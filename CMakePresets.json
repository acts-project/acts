        {
            "name": "github-ci-coverage",
            "displayName": "GitHub-CI Coverage",
            "description": "Coverage build for the build_debug job. Carries no debug info: gcovr/gcov read .gcno and .gcda, never DWARF, so -g would only inflate the ccache footprint. Set the debug level through CMAKE_CXX_FLAGS_DEBUG rather than CMAKE_CXX_FLAGS, or the per-config flags will silently override it. Examples and the vendored Detray/Traccc trees are not built at all: nothing here executes them, and CI/test_coverage.py filters them out of the report, so instrumenting them only produces .gcno with no matching .gcda, which gcovr then counts as uncovered. Note that ACTS_BUILD_PLUGIN_TRACCC=OFF also drops Plugins/Detray and Plugins/Covfie, whose coverage was previously reported; that loss is accepted deliberately in exchange for the build time and cache savings. The ACTS_BUILD_EXAMPLES_* entries below are NOT redundant with ACTS_BUILD_EXAMPLES=OFF: CMakeLists.txt forces ACTS_BUILD_EXAMPLES back on if any single component flag is set, via a normal variable that shadows the cache entry, so every component ci-common turns on must be listed here or Examples comes back.",
            "inherits": "github-ci",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-Werror --coverage",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g0",
                "ACTS_BUILD_ODD": "OFF",
                "ACTS_BUILD_PYTHON_BINDINGS": "OFF",
                "ACTS_BUILD_EXAMPLES": "OFF",
                "ACTS_BUILD_PLUGIN_TRACCC": "OFF",
                "ACTS_BUILD_EXAMPLES_DD4HEP": "OFF",
                "ACTS_BUILD_EXAMPLES_FASTJET": "OFF",
                "ACTS_BUILD_EXAMPLES_ROOT": "OFF",
                "ACTS_BUILD_EXAMPLES_UNITTESTS": "OFF",
                "ACTS_BUILD_EXAMPLES_EDM4HEP": "OFF",
                "ACTS_BUILD_EXAMPLES_PODIO": "OFF",
                "ACTS_BUILD_EXAMPLES_GNN": "OFF",
                "ACTS_BUILD_EXAMPLES_GEANT4": "OFF",
                "ACTS_BUILD_EXAMPLES_PYTHIA8": "OFF",
                "ACTS_BUILD_EXAMPLES_HASHING": "OFF",
                "ACTS_BUILD_EXAMPLES_PARQUET": "OFF"
            }
        },
