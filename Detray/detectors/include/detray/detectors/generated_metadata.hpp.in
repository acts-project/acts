#pragma once

/// @file generated_metadata.hpp
/// @brief Aggregate header for all generated detector metadata of this build.
///
/// This file is generated by CMake. It includes every detector metadata
/// header @c <name>_metadata.hpp that was requested with
/// @c DETRAY_GENERATE_METADATA and defines:
/// - the feature macro @c DETRAY_HAS_<NAME>_METADATA for each header. Use it to
///   guard code that needs one specific generated metadata type.
/// - the X-macro @c DETRAY_FOR_EACH_GENERATED_METADATA(X), which expands to
///   @c X(<name>) for each included header. Use it to write code for all
///   generated metadata types, without naming them.
///
/// @note Generated headers with the same name as a static header in
/// @c detray/detectors are not included and not in the X-macro.
/// @note If no metadata is generated, the X-macro expands to nothing.

// clang-format off
@DETRAY_GENERATED_METADATA_CONTENT@
// clang-format on
